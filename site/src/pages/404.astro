---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL || '/SeaSentinel';
---

<Layout title="404 - Page Not Found">
  <div class="hero min-h-[60vh]">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-9xl font-bold text-error">404</h1>
        <h2 class="text-3xl font-bold mb-4">Page Not Found</h2>
        <p class="mb-8">
          The page you're looking for doesn't exist or has been moved.
        </p>
        <div class="flex flex-col gap-4">
          <a href={`${baseUrl}/`} class="btn btn-primary">
            Go Home
          </a>
          <div class="flex flex-wrap gap-2 justify-center">
            <a href={`${baseUrl}/rulebook`} class="btn btn-ghost btn-sm">Rulebook</a>
            <a href={`${baseUrl}/docs`} class="btn btn-ghost btn-sm">Docs</a>
            <a href={`${baseUrl}/statistics`} class="btn btn-ghost btn-sm">Statistics</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
