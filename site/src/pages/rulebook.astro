---
import Layout from '../layouts/Layout.astro';
import RulebookExplorer from '../components/RulebookExplorer';

const breadcrumbs = [{ label: 'Rulebook', href: '/rulebook' }];
---

<Layout title="Rulebook Explorer" showBreadcrumbs={true} breadcrumbs={breadcrumbs}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-4">Rulebook Explorer</h1>
    <p class="text-lg opacity-80">
      Browse detection rules, protocol signatures, and incident response playbooks for GMDSS security monitoring.
    </p>
  </div>

  <RulebookExplorer client:load />
</Layout>
