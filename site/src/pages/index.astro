---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL || '/SeaSentinel';
---

<Layout title="Home">
  <!-- Hero Section -->
  <div class="hero min-h-[60vh] bg-base-200 rounded-box mb-8">
    <div class="hero-content text-center">
      <div class="max-w-3xl">
        <h1 class="text-5xl font-bold mb-4">
          <span class="text-primary">Sea</span><span class="text-secondary">Sentinel</span>
        </h1>
        <p class="text-2xl mb-6 text-accent">
          GMDSS Maritime Communications IDS
        </p>
        <p class="text-lg mb-8">
          An Intrusion Detection System designed to enhance the security of 
          <strong>Global Maritime Distress and Safety System (GMDSS)</strong> communications,
          monitoring for unauthorized access and anomalies.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={`${baseUrl}/rulebook`} class="btn btn-primary btn-lg">
            Explore Rulebook
          </a>
          <a href={`${baseUrl}/docs`} class="btn btn-secondary btn-lg">
            Read Documentation
          </a>
          <a href="https://github.com/cywf/SeaSentinel" target="_blank" class="btn btn-outline btn-lg">
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Why GMDSS Security Matters -->
  <div class="card bg-base-200 shadow-xl mb-8">
    <div class="card-body">
      <h2 class="card-title text-3xl mb-4">Why GMDSS Security Matters</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="flex gap-4">
          <div class="text-primary text-3xl">🚢</div>
          <div>
            <h3 class="font-bold text-xl mb-2">Critical Maritime Safety</h3>
            <p>GMDSS systems are the lifeline for vessels in distress, coordinating search and rescue operations worldwide.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-secondary text-3xl">🔒</div>
          <div>
            <h3 class="font-bold text-xl mb-2">Prevent Unauthorized Access</h3>
            <p>Detecting and blocking unauthorized transmissions protects the integrity of maritime communications.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-accent text-3xl">⚠️</div>
          <div>
            <h3 class="font-bold text-xl mb-2">Anomaly Detection</h3>
            <p>Identify unusual patterns in DSC, NAVTEX, AIS/NMEA, and voice communications before they become threats.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-info text-3xl">📡</div>
          <div>
            <h3 class="font-bold text-xl mb-2">Multi-Protocol Coverage</h3>
            <p>Monitor and analyze traffic across all major GMDSS protocols including DSC, NAVTEX, and AIS/NMEA.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="grid md:grid-cols-3 gap-6">
    <a href={`${baseUrl}/rulebook`} class="card bg-base-200 shadow-xl hover:shadow-2xl transition card-hover">
      <div class="card-body">
        <h3 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Rulebook Explorer
        </h3>
        <p>Browse detection rules, signatures, and response playbooks</p>
      </div>
    </a>

    <a href={`${baseUrl}/statistics`} class="card bg-base-200 shadow-xl hover:shadow-2xl transition card-hover">
      <div class="card-body">
        <h3 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Repository Statistics
        </h3>
        <p>View project metrics, commits, and contribution stats</p>
      </div>
    </a>

    <a href={`${baseUrl}/discussions`} class="card bg-base-200 shadow-xl hover:shadow-2xl transition card-hover">
      <div class="card-body">
        <h3 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
          </svg>
          Community Discussions
        </h3>
        <p>Join conversations about GMDSS security and features</p>
      </div>
    </a>

    <a href={`${baseUrl}/development-board`} class="card bg-base-200 shadow-xl hover:shadow-2xl transition card-hover">
      <div class="card-body">
        <h3 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
          Development Board
        </h3>
        <p>Track ongoing work and project roadmap</p>
      </div>
    </a>

    <a href={`${baseUrl}/create-issue`} class="card bg-base-200 shadow-xl hover:shadow-2xl transition card-hover">
      <div class="card-body">
        <h3 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Create Issue
        </h3>
        <p>Report bugs, request features, or suggest improvements</p>
      </div>
    </a>

    <a href={`${baseUrl}/visualizer`} class="card bg-base-200 shadow-xl hover:shadow-2xl transition card-hover">
      <div class="card-body">
        <h3 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
          </svg>
          Project Visualizer
        </h3>
        <p>Explore system architecture and flow diagrams</p>
      </div>
    </a>
  </div>

  <!-- Project Info -->
  <div class="mt-12 text-center">
    <div class="stats stats-vertical lg:stats-horizontal shadow bg-base-200">
      <div class="stat">
        <div class="stat-title">License</div>
        <div class="stat-value text-2xl">MIT</div>
        <div class="stat-desc">Open Source</div>
      </div>
      <div class="stat">
        <div class="stat-title">Protocols</div>
        <div class="stat-value text-2xl">DSC, NAVTEX, AIS</div>
        <div class="stat-desc">GMDSS Coverage</div>
      </div>
      <div class="stat">
        <div class="stat-title">GitHub</div>
        <div class="stat-value text-2xl">
          <a href="https://github.com/cywf/SeaSentinel" class="link link-primary">cywf/SeaSentinel</a>
        </div>
        <div class="stat-desc">View Repository</div>
      </div>
    </div>
  </div>
</Layout>
