---
import Layout from '../layouts/Layout.astro';
import StatisticsCharts from '../components/StatisticsCharts';

const breadcrumbs = [{ label: 'Statistics', href: '/statistics' }];
---

<Layout title="Repository Statistics" showBreadcrumbs={true} breadcrumbs={breadcrumbs}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-4">Repository Statistics</h1>
    <p class="text-lg opacity-80">
      Visualize project metrics, contributions, and activity over time.
    </p>
  </div>

  <StatisticsCharts client:load />
</Layout>
