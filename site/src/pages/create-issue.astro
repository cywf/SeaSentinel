---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [{ label: 'Create Issue', href: '/create-issue' }];
const baseUrl = import.meta.env.BASE_URL || '/SeaSentinel';
---

<Layout title="Create Issue" showBreadcrumbs={true} breadcrumbs={breadcrumbs}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-4">Create an Issue</h1>
    <p class="text-lg opacity-80">
      Report bugs, request features, or suggest improvements for SeaSentinel.
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    <!-- Bug Report -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-error">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Bug Report
        </h2>
        <p>Found a bug? Let us know so we can fix it.</p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/SeaSentinel/issues/new?labels=bug&template=bug_report.md&title=[BUG]%20"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-error"
          >
            Report Bug →
          </a>
        </div>
      </div>
    </div>

    <!-- Feature Request -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-success">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Feature Request
        </h2>
        <p>Have an idea? Share your feature suggestions.</p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/SeaSentinel/issues/new?labels=enhancement&template=feature_request.md&title=[FEATURE]%20"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-success"
          >
            Request Feature →
          </a>
        </div>
      </div>
    </div>

    <!-- Documentation -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-info">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Documentation
        </h2>
        <p>Help improve our documentation.</p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/SeaSentinel/issues/new?labels=documentation&template=documentation.md&title=[DOCS]%20"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-info"
          >
            Improve Docs →
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- General Issue -->
  <div class="mt-8 text-center">
    <p class="mb-4">Or create a general issue:</p>
    <a
      href="https://github.com/cywf/SeaSentinel/issues/new/choose"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-lg"
    >
      Choose Template →
    </a>
  </div>

  <!-- Quick Tips -->
  <div class="alert alert-info mt-8">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <div>
      <h3 class="font-bold">Tips for creating issues:</h3>
      <ul class="list-disc list-inside mt-2 text-sm">
        <li>Search existing issues first to avoid duplicates</li>
        <li>Provide clear, detailed information</li>
        <li>Include steps to reproduce for bugs</li>
        <li>Add relevant labels and context</li>
      </ul>
    </div>
  </div>
</Layout>
