---
import ThemeSwitcher from '../components/ThemeSwitcher';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showBreadcrumbs?: boolean;
  breadcrumbs?: { label: string; href: string }[];
}

const { title, description, showBreadcrumbs = false, breadcrumbs = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || '/SeaSentinel';

const navLinks = [
  { label: 'Home', href: `${baseUrl}/` },
  { label: 'Rulebook', href: `${baseUrl}/rulebook` },
  { label: 'Statistics', href: `${baseUrl}/statistics` },
  { label: 'Discussions', href: `${baseUrl}/discussions` },
  { label: 'Dev Board', href: `${baseUrl}/development-board` },
  { label: 'Create Issue', href: `${baseUrl}/create-issue` },
  { label: 'Docs', href: `${baseUrl}/docs` },
  { label: 'Visualizer', href: `${baseUrl}/visualizer` },
];

// Get commit SHA and timestamp (will be injected by CI)
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA || 'dev';
const deployTimestamp = import.meta.env.PUBLIC_DEPLOY_TIMESTAMP || new Date().toISOString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || 'SeaSentinel - GMDSS Maritime Communications IDS'} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <title>{title} | SeaSentinel</title>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    
    <!-- Navbar -->
    <div class="navbar bg-base-200 sticky top-0 z-50 shadow-lg">
      <div class="navbar-start">
        <div class="dropdown">
          <label tabindex="0" class="btn btn-ghost lg:hidden">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h8m-8 6h16"
              />
            </svg>
          </label>
          <ul
            tabindex="0"
            class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-200 rounded-box w-52"
          >
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <a href={`${baseUrl}/`} class="btn btn-ghost text-xl">
          <span class="text-primary">Sea</span><span class="text-secondary">Sentinel</span>
        </a>
      </div>
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          {navLinks.map((link) => (
            <li><a href={link.href} class="btn btn-ghost btn-sm">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="navbar-end gap-2">
        <ThemeSwitcher client:load />
        <a
          href="https://github.com/cywf/SeaSentinel"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm btn-square"
          aria-label="GitHub repository"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Breadcrumbs -->
    {showBreadcrumbs && breadcrumbs.length > 0 && (
      <div class="container mx-auto px-4 py-2">
        <div class="text-sm breadcrumbs">
          <ul>
            <li><a href={`${baseUrl}/`}>Home</a></li>
            {breadcrumbs.map((crumb) => (
              <li><a href={crumb.href}>{crumb.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Main Content -->
    <main id="main-content" class="container mx-auto px-4 py-8 min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-10 bg-base-200 text-base-content">
      <div>
        <p class="font-bold text-lg">
          <span class="text-primary">Sea</span><span class="text-secondary">Sentinel</span>
        </p>
        <p>GMDSS Maritime Communications IDS</p>
        <p class="text-sm opacity-70">
          Licensed under <a href="https://github.com/cywf/SeaSentinel/blob/main/LICENSE" class="link" target="_blank">MIT License</a>
        </p>
        <div class="flex gap-4 text-xs opacity-60">
          <span>Deploy: {new Date(deployTimestamp).toLocaleDateString()}</span>
          <span>•</span>
          <span>Commit: <code class="text-xs">{commitSha.substring(0, 7)}</code></span>
        </div>
      </div>
    </footer>
  </body>
</html>
